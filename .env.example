# ==============================================================================
# Environment Variables Template (.env.example) for WololoRAG (Indexer Service)
# Copy this file to ".env" and customize when needed.
#
# By default (with empty .env), the Indexer stores state locally in `./data/`.
# To connect to the shared Docker databases from `WololoRAG-Infra` on localhost,
# uncomment DATABASE_URL, QDRANT_MODE, and QDRANT_URL below.
# ==============================================================================

# --- Option A: Connect to PostgreSQL + Qdrant from `WololoRAG-Infra` (Docker) ---
# DATABASE_URL=postgresql+psycopg://wololo:wololo_pass@localhost:5432/wololo_rag
# QDRANT_MODE=server
# QDRANT_URL=http://localhost:6333

# --- Option B: Local File Databases (defaults if above are commented out) ---
# SQLITE_PATH=./data/wololo_state.db
# QDRANT_MODE=local
# QDRANT_LOCAL_PATH=./data/qdrant

# --- Required ONLY when embedding.provider is set to "mistral" in config/app_config.yaml ---
MISTRAL_API_KEY=
